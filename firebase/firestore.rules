rules_version = '2';

// TwinGuard-SHA256 Firestore security rules (free Spark plan).
// The dashboard server uses the Admin SDK, which bypasses these rules.
// They govern the operators' phone apps and detection engines.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Operator exists and has not been disabled by the admin
    function isActiveOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().enabled == true;
    }

    // A sealed detection: the SHA-256 seal is the document id
    function validDetection(uid, detectionId) {
      let d = request.resource.data;
      return d.uid == uid
        && d.username == profile().username
        && d.sha256_hash is string
        && d.sha256_hash.size() == 64
        && d.sha256_hash == detectionId
        && d.severity in ['HIGH', 'MEDIUM', 'LOW']
        && d.timestamp is string;
    }

    // Operator profile: readable by its owner; only the admin dashboard writes profiles.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      // The operator's own space: EVERY detection from their phone app or detector.
      //   read:   the operator, only their own
      //   create: the operator's app/detector, only as themselves, sealed
      //   update/delete: never from clients, so the evidence cannot be altered
      // The admin dashboard receives only the HIGH (critical) ones.
      match /detections/{detectionId} {
        allow read: if isActiveOperator() && request.auth.uid == uid;
        allow create: if isActiveOperator() && request.auth.uid == uid
          && validDetection(uid, detectionId);
        allow update, delete: if false;
      }

      // The operator's own space: FULL scan results (every network seen in one scan).
      // Private to the operator; the admin dashboard does not read these.
      match /scans/{scanId} {
        allow read: if isActiveOperator() && request.auth.uid == uid;
        allow create: if isActiveOperator() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.timestamp is string
          && request.resource.data.networks is list
          && request.resource.data.networks.size() <= 300;
        allow update, delete: if false;
      }
    }

    // Admin records, the old shared alerts collection, and anything else: server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
